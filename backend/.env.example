# Copy to .env and fill in. npm start / npm run dev load it automatically.

PORT=3000
# Your app's domain in production, e.g. https://myrecipeapp.com
CORS_ORIGIN=*

# AI extraction (Claude): turns messy captions and video transcripts into recipes.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
# AI_EFFORT=low

# Speech-to-text for uploaded videos (OpenAI). Get a key at https://platform.openai.com
OPENAI_API_KEY=
# TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Optional: path to ffmpeg. With it, any video (.mov too) is shrunk to audio before upload.
# FFMPEG_PATH=ffmpeg
# MAX_UPLOAD_MB=100


# Paid TikTok API (ScrapeCreators): lets a TikTok link alone work, no download needed from the user.
# Gets the caption, TikTok's subtitles and the video URL. About 1 credit (~$0.002) per link.
# Get a key at https://scrapecreators.com
SCRAPECREATORS_API_KEY=
# SCRAPECREATORS_REGION=US
# TIKTOK_MAX_VIDEO_SECONDS=600

# Cost log: each recipe request prints what it cost and appends a JSON line to logs/costs.jsonl.
# Prices are in src/config/pricing.js (they only affect the log).
# COST_LOG=off              # no cost logging at all
# COST_LOG_FILE=off         # console line only, no file
# SCRAPECREATORS_USD_PER_CREDIT=0.00188   # $47 / 25,000 credits; set yours if you bought another pack

# Accounts: Better Auth (email + password) on a Neon Postgres database, via Drizzle.
# Without DATABASE_URL the recipe routes still work; /api/auth, /me and /recipes answer 503.
# Neon dashboard > your project > Connect > copy the connection string.
DATABASE_URL=
# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# Where this API runs (the auth routes live under /api/auth).
BETTER_AUTH_URL=http://localhost:3000
# Frontends allowed to send the login cookie (comma-separated). Also trusted by Better Auth.
# APP_ORIGINS=http://localhost:3001
